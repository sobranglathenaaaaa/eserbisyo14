# ==========================================
# Email Configuration (Nodemailer / Brevo / Resend)
# ==========================================

# Email Provider: 'brevo-api' | 'brevo-smtp' | 'nodemailer' | 'resend' | 'auto'
EMAIL_PROVIDER=auto

# Sender Email Address & Display Name
EMAIL_SENDER=no-reply@eserbisyo.gov.ph
EMAIL_SENDER_NAME="E-Serbisyo System"

# ------------------------------------------
# Option 1: Brevo REST API v3 Configuration
# ------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here

# ------------------------------------------
# Option 2: Brevo SMTP / Nodemailer Configuration
# ------------------------------------------
# Brevo SMTP Relay Server
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_account_email@domain.com
SMTP_PASS=your_brevo_smtp_key_here
SMTP_SECURE=false

# ------------------------------------------
# Option 3: Resend Configuration (Legacy)
# ------------------------------------------
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=onboarding@resend.dev
