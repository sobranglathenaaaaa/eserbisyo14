# Registration email verification toggle (production only)
# Allowed values: true | false
EMAIL_VERIFICATION_ENABLED=true

# Email verification delivery (Resend)
# Use a sender address from your verified domain in Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_SENDER=eSerbisyo <no-reply@zentariph.com>
# Public app URL used to build email links.
# Local dev: http://localhost:3000
# Production: https://your-domain.tld
NEXT_PUBLIC_APP_URL=https://your-domain.tld
